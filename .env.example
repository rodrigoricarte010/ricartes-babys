# ─────────────────────────────────────────────────────────────
# Ricartes Babys — variáveis de ambiente
# ─────────────────────────────────────────────────────────────
# SEM estas variáveis o app roda em MODO LOCAL: os dados ficam
# apenas no navegador (IndexedDB) e já vêm com a Rosie Grace de
# exemplo. Ideal para testar.
#
# COM estas variáveis o app roda em MODO NUVEM: cria conta,
# sincroniza entre aparelhos e compartilha com a família.
#
# Como criar o projeto (grátis): https://supabase.com
#   1. New project
#   2. Rode o conteúdo de supabase/schema.sql no SQL Editor
#   3. Copie as duas chaves abaixo (Settings → API)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: nome exibido no cabeçalho
NEXT_PUBLIC_FAMILY_NAME=Ricartes
